{%- comment -%} Product popup shell — hydrated by ecl-library.js (vanilla JS only) {%- endcomment -%}
<div
  class="ecl-popup-overlay"
  data-ecl-popup-overlay
  hidden
  aria-hidden="true"
>
  <div
    class="ecl-popup"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ecl-popup-title"
    data-ecl-popup
  >
    <button
      type="button"
      class="ecl-icon-btn ecl-icon-btn--close ecl-popup__close"
      data-ecl-close-popup
      aria-label="Close"
    >
      <span class="ecl-icon-btn__glyph" aria-hidden="true"></span>
    </button>

    <div class="ecl-popup__top">
      <img class="ecl-popup__image" data-ecl-popup-image src="" alt="" width="100" height="100">
      <div class="ecl-popup__meta">
        <h2 class="ecl-popup__title" id="ecl-popup-title" data-ecl-popup-title></h2>
        <p class="ecl-popup__price" data-ecl-popup-price></p>
        <p class="ecl-popup__description" data-ecl-popup-description></p>
      </div>
    </div>

    <div class="ecl-popup__fields" data-ecl-popup-fields></div>

    <button type="button" class="ecl-btn ecl-btn--black ecl-btn--block ecl-popup__atc" data-ecl-atc>
      <span>ADD TO CART</span>
      <span class="ecl-btn__arrow" aria-hidden="true">→</span>
    </button>

    <p class="ecl-popup__status" data-ecl-popup-status role="status" aria-live="polite"></p>
  </div>
</div>
